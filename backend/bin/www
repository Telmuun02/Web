#!/usr/bin/env node

/**
 * энэхүү файл нь серверийг эхлүүлдэг. App.js ийн app ийг ажлуулж,
 * port дээр сонсож, алдаа гарвал лог бичнэ. Энэ нь Express-ийн стандарт www файл юм.
 */

var path = require('path');
require('dotenv').config({ path: path.join(__dirname, '..', '.env'), quiet: true });

var app = require('../app');
var realtime = require('../lib/realtime/node');
var debug = require('debug')('backend:server');
var http = require('http');
var log = require('../lib/logger').child({ module: 'server' });

process.on('unhandledRejection', function (err) {
  log.error({ err: err }, 'Барьж аваагүй promise алдаа');
});
process.on('uncaughtException', function (err) {
  log.fatal({ err: err }, 'Барьж аваагүй алдаа');
  process.exit(1);
});


var port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

var server = http.createServer(app);
realtime.attach(server);

server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    return val;
  }

  if (port >= 0) {
    return port;
  }

  return false;
}

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  switch (error.code) {
    case 'EACCES':
      log.fatal({ port: port }, bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      log.fatal({ port: port }, bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
  log.info({ port: addr.port }, 'Сервер асав');
}
