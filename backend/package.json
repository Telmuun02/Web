{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node ./bin/www",
    "start": "node ./bin/www",
    "db:check": "node db/check.js",
    "migrate": "node db/migrate.js",
    "seed": "knex --knexfile db/knexfile.js seed:run",
    "seed:make": "knex --knexfile db/knexfile.js seed:make",
    "db:import-mysql": "node db/import-mysql.js",
    "user:create": "node db/create-user.js",
    "logs": "node scripts/logs.js",
    "logs:clear": "node scripts/clear-logs.js",
    "cf:dev": "wrangler dev --remote",
    "d1:create": "wrangler d1 create sukh-hub",
    "d1:migrate": "wrangler d1 migrations apply sukh-hub --remote",
    "d1:seed": "node db/export.js && wrangler d1 execute sukh-hub --remote --file .data/seed.sql",
    "deploy": "npm --prefix ../frontend run build && wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "dotenv": "^18.0.9",
    "express": "~4.16.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "morgan": "~1.9.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "mysql2": "^3.24.6",
    "wrangler": "^4.166.0"
  },
  "allowScripts": {
    "workerd@1.20261119.1": true,
    "esbuild@0.28.2": true
  }
}
