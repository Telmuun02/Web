// Cloudflare Worker-ийн тохиргоо (npm run deploy)
// Нууц утгуудыг энд бичихгүй — `npx wrangler secret put JWT_SECRET` гэх мэтээр Cloudflare-д хадгална.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sukh-hub",
	"main": "worker.js",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Worker-ийг D1-ийн ойролцоо ажиллуулна — хуудас бүрийн олон query хол зам дахин дахин явахгүй
	"placement": { "mode": "smart" },
	// process.env-д орох энгийн (нууц биш) утгууд
	"vars": {
		"NODE_ENV": "production",
		"JWT_EXPIRES_IN": "7d"
	},
	// D1 өгөгдлийн сан — Ази (APAC) бүсэд. database_id-г `npm run d1:create` командын хариунаас хуулна.
	// Хуучин Баруун Европын (WEUR) D1 'sukh-hub' (2c34d8ac-...) нөөц болж үлдсэн — 2026-11-22-нд шилжүүлэв
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sukh-hub-asia",
			"database_id": "162d518c-0c9f-4843-a082-68fe19032bd3",
			"migrations_dir": "migrations"
		}
	],
	// Realtime (WebSocket) — бүх холболтыг барих Durable Object (lib/realtime/durable.js)
	"durable_objects": {
		"bindings": [{ "name": "REALTIME", "class_name": "RealtimeHub" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["RealtimeHub"] }],
	// Frontend (Vite build). /api/* хүсэлт Worker-т, бусад нь шууд эндээс; React Router-ийн замууд index.html руу
	"assets": {
		"directory": "../frontend/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	// Knex бүх өгөгдлийн сангийн driver-ийг require хийдэг — ашиглахгүй тул хоосон файлаар солино.
	// pino нь зөвхөн компьютер дээр (lib/logger.js) хэрэглэгдэнэ.
	"alias": {
		"better-sqlite3": "./lib/empty.js",
		"sqlite3": "./lib/empty.js",
		"mysql": "./lib/empty.js",
		"mysql2": "./lib/empty.js",
		"mariadb/callback": "./lib/empty.js",
		"pg": "./lib/empty.js",
		"pg-query-stream": "./lib/empty.js",
		"oracledb": "./lib/empty.js",
		"tedious": "./lib/empty.js",
		"pino": "./lib/empty.js",
		"pino-pretty": "./lib/empty.js",
		"iconv-lite": "./lib/iconv-lite.js"
	},
	// Cloudflare dashboard → Workers → sukh-hub → Logs
	"observability": {
		"enabled": true
	}
}