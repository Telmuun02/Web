{
  "name": "sukh-hub",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install && npm --prefix mobile install",
    "dev": "concurrently -n be,fe -c blue,green \"npm run be\" \"npm run fe\"",
    "be": "npm --prefix backend run dev",
    "fe": "npm --prefix frontend run dev",
    "mobile": "npm --prefix mobile start",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "migrate": "npm --prefix backend run migrate",
    "seed": "npm --prefix backend run seed",
    "logs": "npm --prefix backend run logs",
    "d1:migrate": "npm --prefix backend run d1:migrate",
    "deploy": "npm --prefix backend run deploy"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
